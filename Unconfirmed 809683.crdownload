/* ---------------- helpers ---------------- */

class AppError extends Error {
  constructor(message, detail) {
    super(message);
    this.name = 'AppError';
    this.detail = detail || '';
  }
}

const clamp = (n, min, max) => Math.min(max, Math.max(min, n));

const num = (value) => {
  if (typeof value === 'number' && isFinite(value)) return value;
  const match = String(value ?? '').replace(',', '.').match(/-?\d+(?:\.\d+)?/);
  return match ? parseFloat(match[0]) : 0;
};

const round1 = (n) => Math.round(n * 10) / 10;

const fmt = (n) => {
  const v = Math.round(num(n));
  return String(v).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
};

const dateKey = (d = new Date()) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

const uid = () =>
  window.crypto && crypto.randomUUID
    ? crypto.randomUUID()
    : `e${Date.now().toString(36)}${Math.random().toString(36).slice(2, 7)}`;

const esc = (value) =>
  String(value ?? '').replace(/[&<>"']/g, (c) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }[c]));

function readJSON(key, fallback) {
  try {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  } catch {
    return fallback;
  }
}

function writeJSON(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
  } catch {
    toast('Yaddaş dolub. Köhnə qeydləri sil.');
  }
}

function loadSettings() {
  const saved = readJSON(LS.settings, {}) || {};
  const s = {
    model: String(saved.model || AI.model),
    goal: clamp(Math.round(num(saved.goal) || 2000), 800, 8000),
    theme: ['auto', 'light', 'dark'].includes(saved.theme) ? saved.theme : 'auto',
    apiKey: CONFIG.geminiApiKey ? '' : String(saved.apiKey || ''),
    profile: sanitizeProfile(saved.profile),
  };
  // Yeni istifadəçilər üçün bağlanmış köhnə Gemini modellərini avtomatik yenilə
  if (/^gemini-(1\.5|2\.0|2\.5)(-|$)/.test(s.model)) {
    s.model = AI.model;
  }
  return s;
}

function activeApiKey() {
  return String(CONFIG.geminiApiKey || state.settings.apiKey || '').trim();
}

/* ---------------- toast ---------------- */

let toastTimer = null;

function toast(message) {
  const el = $('#toast');
  if (!el) return;
  el.textContent = message;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 2600);
}

/* ---------------- init ---------------- */

document.addEventListener('DOMContentLoaded', init);

function init() {
  state.settings = loadSettings();
  state.entries = readJSON(LS.entries, []);
  if (!Array.isArray(state.entries)) state.entries = [];
  state.selectedDate = dateKey();
  state.today = state.selectedDate;

  // köhnə versiyadan qalan açar/provider sahələrini yaddaşdan sil
  writeJSON(LS.settings, state.settings);

  bindEvents();
  applyTheme(state.settings.theme);
  bindSystemTheme();
  renderTodayLabel();
  renderVersion();
  fillSettings();
  renderAiStatus();
  renderHomeSummary();
  renderDiary();
  setTab('home');
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') rollDay();
  });
  maybeShowIosHint();
  registerSW();
}

