/* ---------------- navigation ---------------- */

function setTab(tab) {
  rollDay();
  state.tab = tab;
  $$('.view').forEach((view) => view.classList.toggle('active', view.id === `view-${tab}`));
  $$('.tab').forEach((btn) => {
    const active = btn.dataset.tab === tab;
    btn.classList.toggle('active', active);
    btn.setAttribute('aria-selected', active ? 'true' : 'false');
  });
  if (tab === 'diary') renderDiary();
  if (tab === 'settings') fillSettings();
  if (tab === 'home') renderHomeSummary();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function onGlobalClick(event) {
  const tabBtn = event.target.closest('[data-tab]');
  if (tabBtn) {
    setTab(tabBtn.dataset.tab);
    return;
  }

  const del = event.target.closest('[data-del]');
  if (del) {
    event.stopPropagation();
    removeEntry(del.dataset.del);
    return;
  }

  const edit = event.target.closest('[data-edit]');
  if (edit) {
    event.stopPropagation();
    editEntry(edit.dataset.edit);
    return;
  }

  const dayBtn = event.target.closest('[data-day]');
  if (dayBtn) {
    selectDate(dayBtn.dataset.day);
    return;
  }

  const expand = event.target.closest('[data-expand]');
  if (expand) {
    toggleEntryDetails(expand.dataset.expand);
  }
}

function renderTodayLabel() {
  const d = new Date();
  $('#todayLabel').textContent = `${d.getDate()} ${AZ_MONTHS[d.getMonth()]}, ${AZ_WEEKDAYS[d.getDay()]}`;
}

/* ---------------- capture & compress ---------------- */

function onPickFile(event) {
  const file = event.target.files && event.target.files[0];
  event.target.value = '';
  if (file) handleFile(file);
}

async function handleFile(file) {
  if (!file.type.startsWith('image/')) {
    toast('Şəkil faylı seç');
    return;
  }
  if (file.size > 20 * 1024 * 1024) {
    toast('Şəkil çox böyükdür (max 20 MB)');
    return;
  }
  try {
    const source = await decodeImage(file);
    const { dataUrl, thumb } = drawScaled(source);
    if (source.close) source.close();

    state.pending = { dataUrl, thumb };
    state.analysis = null;

    $('#previewImg').src = dataUrl;
    $('#analyzeHint').textContent = 'Şəkil Google Gemini-yə göndəriləcək.';
    $('#btnAnalyze').disabled = false;
    $('#btnAnalyze').textContent = 'AI ilə analiz et';

    $('#errorCard').classList.add('hidden');
    $('#loadingCard').classList.add('hidden');
    $('#resultCard').classList.add('hidden');
    $('#analyzeCard').classList.remove('hidden');
    $('#analyzeCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch (err) {
    console.warn(err);
    toast('Şəkil açılmadı. JPEG/PNG formatında yoxla.');
  }
}

function decodeImage(file) {
  if (window.createImageBitmap) {
    return createImageBitmap(file, { imageOrientation: 'from-image' }).catch(() => loadImageElement(file));
  }
  return loadImageElement(file);
}

function loadImageElement(file) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      resolve(img);
    };
    img.onerror = () => {
      URL.revokeObjectURL(url);
      reject(new Error('decode'));
    };
    img.src = url;
  });
}

function drawScaled(source) {
  const sw = source.width;
  const sh = source.height;
  const scale = Math.min(1, 1200 / Math.max(sw, sh));
  const w = Math.max(1, Math.round(sw * scale));
  const h = Math.max(1, Math.round(sh * scale));

  const canvas = document.createElement('canvas');
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(source, 0, 0, w, h);
  const dataUrl = canvas.toDataURL('image/jpeg', 0.86);

  const tScale = Math.min(1, 260 / Math.max(w, h));
  const tw = Math.max(1, Math.round(w * tScale));
  const th = Math.max(1, Math.round(h * tScale));
  const tCanvas = document.createElement('canvas');
  tCanvas.width = tw;
  tCanvas.height = th;
  tCanvas.getContext('2d').drawImage(canvas, 0, 0, tw, th);
  const thumb = tCanvas.toDataURL('image/jpeg', 0.72);

  return { dataUrl, thumb };
}

function resetCapture() {
  state.pending = null;
  state.analysis = null;
  state.editing = null;
  $('#resultBody').innerHTML = '';
  $('#previewImg').removeAttribute('src');
  $('#analyzeCard').classList.add('hidden');
  $('#resultCard').classList.add('hidden');
  $('#errorCard').classList.add('hidden');
  $('#loadingCard').classList.add('hidden');
}

/* ---------------- AI ---------------- */

async function analyze() {
  if (state.busy) return;
  if (!state.pending) {
    toast('Əvvəlcə şəkil seç');
    return;
  }

  const settings = state.settings;
  if (!activeApiKey()) {
    toast('AI açarı yoxdur — Ayarlarda əlavə et');
    setTab('settings');
    return;
  }

  state.busy = true;
  state.source = 'photo';
  state.editing = null;
  $('#btnAnalyze').disabled = true;
  $('#analyzeCard').classList.add('hidden');
  $('#resultCard').classList.add('hidden');
  $('#errorCard').classList.add('hidden');
  $('#loadingCard').classList.remove('hidden');
  startLoadingMessages();

  try {
    const raw = await analyzePhoto(state.pending.dataUrl, settings);
    const analysis = normalizeAnalysis(raw);
    analysis.thumb = state.pending.thumb;
    state.analysis = analysis;

    renderResult();
    $('#loadingCard').classList.add('hidden');
    $('#resultCard').classList.remove('hidden');
    $('#resultCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch (err) {
    console.error(err);
    $('#loadingCard').classList.add('hidden');
    renderError(err);
  } finally {
    state.busy = false;
    stopLoadingMessages();
    $('#btnAnalyze').disabled = false;
  }
}

async function analyzePhoto(dataUrl, settings) {
  if (!dataUrl || dataUrl.indexOf(',') === -1) {
    throw new AppError('Şəkil yoxdur. Yenidən seç.');
  }
  return callGemini(dataUrl, settings);
}

async function callGemini(dataUrl, settings) {
  const base64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
  return geminiRequest(
    [{ text: PROMPT }, { inline_data: { mime_type: 'image/jpeg', data: base64 } }],
    SCHEMA,
    settings
  );
}

async function geminiRequest(parts, schema, settings) {
  const apiKey = activeApiKey();
  if (!apiKey) throw new AppError('AI açarı yoxdur. Ayarlarda əlavə et.');

  const requested = (settings.model || AI.model).replace(/^models\//, '').trim();
  const chain = [requested, ...GEMINI_FALLBACKS.filter((model) => model !== requested)].slice(0, 3);
  let lastError = null;
  let retired = false;

  for (const model of chain) {
    try {
      const result = await requestGemini(parts, apiKey, model, schema);
      if (model !== requested) {
        if (retired) {
          state.settings.model = model;
          writeJSON(LS.settings, state.settings);
          toast(`Model avtomatik yeniləndi: ${model}`);
          if (state.tab === 'settings') fillSettings();
        } else {
          console.info(`“${requested}” hazırda cavab vermədi, “${model}” istifadə olundu.`);
        }
      }
      return result;
    } catch (err) {
      lastError = err;
      if (err instanceof AppError && err.status === 404) retired = true;
      const retryable =
        err instanceof AppError && (err.retryModel === true || [404, 429, 503].includes(err.status));
      if (!retryable) throw err;
      console.warn(`Gemini modeli “${model}” uğursuz oldu:`, err.message);
    }
  }

  throw lastError;
}

async function requestGemini(parts, apiKey, model, schema) {
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${encodeURIComponent(apiKey)}`;

  const res = await request(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      contents: [{ role: 'user', parts }],
      generationConfig: {
        temperature: 0.2,
        maxOutputTokens: 8192,
        responseMimeType: 'application/json',
        responseSchema: schema,
      },
    }),
  });

  if (!res.ok) throw await apiError(res);

  const data = await res.json();
  const candidate = data && data.candidates && data.candidates[0];
  if (!candidate) {
    const blocked = data && data.promptFeedback && data.promptFeedback.blockReason;
    throw new AppError('AI cavab vermədi.', blocked ? `Səbəb: ${blocked}` : '');
  }

  const text = (candidate.content?.parts || [])
    .filter((part) => !part.thought)
    .map((part) => part.text || '')
    .filter(Boolean)
    .join('\n');

  if (!text.trim()) {
    const error = new AppError(
      'AI cavabı boş gəldi — başqa model yoxlanılır.',
      `Səbəb: ${candidate.finishReason || 'naməlum'}`
    );
    error.retryModel = true;
    throw error;
  }

  return parseAIJson(text);
}

async function request(url, options, timeoutMs = 70000) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    return await fetch(url, { ...options, signal: controller.signal });
  } catch (err) {
    if (err && err.name === 'AbortError') {
      throw new AppError('AI cavab vermədi (vaxt bitdi). Yenidən cəhd et.');
    }
    throw new AppError('İnternetə qoşulmaq alınmadı. Bağlantını yoxla.');
  } finally {
    clearTimeout(timer);
  }
}

async function apiError(res) {
  let detail = '';
  try {
    const data = await res.json();
    detail = data?.error?.message || data?.message || data?.error || '';
    if (typeof detail !== 'string') detail = JSON.stringify(detail);
  } catch {
    try {
      detail = (await res.text()).slice(0, 300);
    } catch {
      detail = '';
    }
  }

  const invalidKey = /api key not valid|api_key_invalid|api key expired|access_token_type_unsupported/i.test(detail);
  if (invalidKey) {
    const error = new AppError('API açarı etibarsızdır — Ayarlarda yeni açar daxil et', detail);
    error.status = 401;
    return error;
  }

  const map = {
    400: 'Sorğu qəbul edilmədi (400)',
    401: 'API açarı etibarsızdır (401) — Ayarlarda yeni açar daxil et',
    403: 'Bu açarın icazəsi yoxdur (403)',
    404: 'Model mövcud deyil (404) — Ayarlarda “Modelləri gətir” ilə yenilə',
    413: 'Şəkil çox böyükdür (413)',
    415: 'Şəkil formatı dəstəklənmir (415)',
    429: 'Pulsuz limit bitdi (429)',
    500: 'AI server xətası (500)',
    502: 'AI server cavab vermir (502)',
    503: 'Model hazırda yüklüdür (503) — bir az sonra yenidən cəhd et',
  };

  const error = new AppError(map[res.status] || `AI xətası (${res.status})`, detail);
  error.status = res.status;
  return error;
}

function parseAIJson(text) {
  if (!text || typeof text !== 'string') {
    throw new AppError('AI boş cavab qaytardı. Yenidən cəhd et.');
  }
  let clean = text.trim().replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();
  const start = clean.indexOf('{');
  const end = clean.lastIndexOf('}');
  if (start === -1 || end <= start) {
    throw new AppError('AI cavabı oxunmadı. Yenidən cəhd et.');
  }
  clean = clean.slice(start, end + 1);
  try {
    return JSON.parse(clean);
  } catch {
    throw new AppError('AI düzgün JSON qaytarmadı. Yenidən cəhd et.');
  }
}

function normalizeAnalysis(raw) {
  const obj = raw && typeof raw === 'object' ? raw : {};
  const totalsRaw = obj.totals && typeof obj.totals === 'object' ? obj.totals : {};

  const ingredients = (Array.isArray(obj.ingredients) ? obj.ingredients : [])
    .map((item) => {
      const grams = clamp(num(item?.grams ?? item?.weight ?? item?.qram), 0.5, 5000);
      let protein = Math.max(0, num(item?.protein));
      let carbs = Math.max(0, num(item?.carbs));
      let fat = Math.max(0, num(item?.fat));
      let kcal = Math.max(0, num(item?.kcal ?? item?.calories));
      if (!kcal && (protein || carbs || fat)) kcal = protein * 4 + carbs * 4 + fat * 9;

      return {
        name: String(item?.name || 'Tərkib').slice(0, 80).trim(),
        grams: Math.max(1, Math.round(grams)),
        kcal: Math.round(kcal),
        protein: round1(protein),
        carbs: round1(carbs),
        fat: round1(fat),
        perGram: {
          kcal: kcal / grams,
          protein: protein / grams,
          carbs: carbs / grams,
          fat: fat / grams,
        },
      };
    })
    .filter((item) => item.name && item.grams > 0)
    .slice(0, 12);

  const confidenceRaw = num(obj.confidence);
  const analysis = {
    dish: String(obj.dish || obj.name || 'Naməlum yemək').slice(0, 120).trim(),
    description: String(obj.description || '').slice(0, 400).trim(),
    cuisine: String(obj.cuisine || '').slice(0, 60).trim(),
    ingredients,
    confidence: clamp(confidenceRaw > 1 ? confidenceRaw / 100 : confidenceRaw, 0, 1),
    notes: String(obj.notes || '').slice(0, 500).trim(),
    health: String(obj.health || '').slice(0, 400).trim(),
    totals: {
      kcal: Math.max(0, Math.round(num(totalsRaw.kcal))),
      protein: Math.max(0, round1(num(totalsRaw.protein))),
      carbs: Math.max(0, round1(num(totalsRaw.carbs))),
      fat: Math.max(0, round1(num(totalsRaw.fat))),
      fiber: Math.max(0, round1(num(totalsRaw.fiber))),
      grams: 0,
    },
  };

  recomputeTotals(analysis);
  return analysis;
}

function recomputeTotals(analysis) {
  if (!analysis.ingredients.length) {
    analysis.totals = {
      kcal: 0,
      protein: 0,
      carbs: 0,
      fat: 0,
      fiber: analysis.totals ? analysis.totals.fiber || 0 : 0,
      grams: 0,
    };
    analysis.healthScore = computeHealthScore(analysis.dish, analysis.ingredients, analysis.totals);
    return;
  }

  let kcal = 0;
  let protein = 0;
  let carbs = 0;
  let fat = 0;
  let grams = 0;

  for (const item of analysis.ingredients) {
    kcal += item.kcal;
    protein += item.protein;
    carbs += item.carbs;
    fat += item.fat;
    grams += item.grams;
  }

  analysis.totals = {
    ...analysis.totals,
    kcal: Math.round(kcal),
    protein: round1(protein),
    carbs: round1(carbs),
    fat: round1(fat),
    grams: Math.round(grams),
  };
  analysis.healthScore = computeHealthScore(analysis.dish, analysis.ingredients, analysis.totals);
}

/* ---------------- loading / error ---------------- */

let loadTimer = null;
let loadIndex = 0;

function startLoadingMessages(messages = LOAD_MSGS) {
  loadIndex = 0;
  $('#loadingText').textContent = messages[0];
  clearInterval(loadTimer);
  loadTimer = setInterval(() => {
    loadIndex = (loadIndex + 1) % messages.length;
    $('#loadingText').textContent = messages[loadIndex];
  }, 2200);
}

function stopLoadingMessages() {
  clearInterval(loadTimer);
}

const TEXT_LOAD_MSGS = [
  'AI yeməyi tanıyır…',
  'Tərkib hissələri müəyyən edilir…',
  'Qramlar və kalori hesablanır…',
];

function onTextSubmit(event) {
  event.preventDefault();
  runTextAnalysis($('#textDish').value);
}

function retryAnalysis() {
  if (state.source === 'text' && state.lastQuery) runTextAnalysis(state.lastQuery);
  else analyze();
}

function focusTextAdd() {
  setTab('home');
  setTimeout(() => {
    $('#textAddCard').scrollIntoView({ behavior: 'smooth', block: 'center' });
    $('#textDish').focus();
  }, 250);
}

async function runTextAnalysis(rawQuery) {
  if (state.busy) return;
  const query = String(rawQuery || '').replace(/\s+/g, ' ').trim().slice(0, 120);
  if (!query) {
    toast('Yeməyin adını yaz');
    return;
  }
  if (!activeApiKey()) {
    toast('AI açarı yoxdur — Ayarlarda əlavə et');
    setTab('settings');
    return;
  }

  state.busy = true;
  state.source = 'text';
  state.lastQuery = query;
  state.editing = null;
  state.pending = { dataUrl: '', thumb: '' };
  state.analysis = null;
  $('#btnTextAnalyze').disabled = true;
  $('#btnTextAnalyze').textContent = 'Axtarılır…';
  $('#analyzeCard').classList.add('hidden');
  $('#resultCard').classList.add('hidden');
  $('#errorCard').classList.add('hidden');
  $('#loadingCard').classList.remove('hidden');
  $('#loadingCard').scrollIntoView({ behavior: 'smooth', block: 'center' });
  startLoadingMessages(TEXT_LOAD_MSGS);

  try {
    const raw = await geminiRequest([{ text: textPrompt(query) }], SCHEMA, state.settings);
    const analysis = normalizeAnalysis(raw);
    if (!analysis.ingredients.length) {
      throw new AppError('Yemək tapılmadı. Adı dəqiqləşdirib yenidən yoxla.', analysis.notes);
    }
    analysis.thumb = '';
    state.analysis = analysis;

    renderResult();
    $('#loadingCard').classList.add('hidden');
    $('#resultCard').classList.remove('hidden');
    $('#resultCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
    $('#textDish').value = '';
  } catch (err) {
    console.error(err);
    $('#loadingCard').classList.add('hidden');
    renderError(err);
    $('#btnAnalyze').textContent = 'AI ilə analiz et';
  } finally {
    state.busy = false;
    stopLoadingMessages();
    $('#btnTextAnalyze').disabled = false;
    $('#btnTextAnalyze').textContent = 'AI tapsın';
  }
}

function renderError(err) {
  const message = err instanceof AppError ? err.message : 'Gözlənilməz xəta baş verdi.';
  $('#errorText').textContent = message;
  $('#errorDetail').textContent = err && err.detail ? String(err.detail).slice(0, 400) : '';
  $('#errorDetail').hidden = !(err && err.detail);
  $('#errorCard').classList.remove('hidden');
  $('#analyzeCard').classList.add('hidden');
  $('#resultCard').classList.add('hidden');
  $('#btnAnalyze').textContent = 'Yenidən cəhd et';
  $('#errorCard').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

/* ---------------- result ---------------- */

function renderResult() {
  const analysis = state.analysis;
  if (!analysis) return;

  if (state.editing) {
    const currentName = $('#editDish');
    if (currentName) {
      analysis.dish = currentName.value;
      analysis.healthScore = computeHealthScore(analysis.dish, analysis.ingredients, analysis.totals);
    }
  }

  const t = analysis.totals;
  const score = analysis.healthScore || computeHealthScore(analysis.dish, analysis.ingredients, t);
  const macroKcal = t.protein * 4 + t.carbs * 4 + t.fat * 9;
  const base = macroKcal || t.kcal || 1;
  const pPct = Math.round((t.protein * 4) / base * 100);
  const cPct = Math.round((t.carbs * 4) / base * 100);
  const fPct = Math.max(0, 100 - pPct - cPct);
  const conf = Math.round(analysis.confidence * 100);
  const editing = Boolean(state.editing);

  const chips = [
    editing ? '<span class="chip">Redaktə</span>' : '',
    score ? `<span class="chip score-${scoreBand(score)}">Sağlamlıq ${score}/10</span>` : '',
    analysis.cuisine ? `<span class="chip">${esc(analysis.cuisine)}</span>` : '',
    analysis.confidence ? `<span class="chip chip-soft">AI inamı ${conf}%</span>` : '',
    analysis.aiRecalculated ? `<span class="chip chip-soft">AI yenilədi</span>` : '',
  ].join('');

  const ingredients = analysis.ingredients.length
    ? analysis.ingredients.map((item, index) => ingredientRow(item, index)).join('')
    : '<p class="empty">Tərkib yoxdur. Aşağıdan ərzaq əlavə et.</p>';

  $('#resultBody').innerHTML = `
    <div class="result-head">
      <div class="result-title">
        <div>${chips}</div>
        ${
          editing
            ? `<input class="dish-input" id="editDish" type="text" maxlength="80" value="${esc(analysis.dish)}" aria-label="Yeməyin adı">`
            : `<h2>${esc(analysis.dish)}</h2>`
        }
        ${analysis.description ? `<p>${esc(analysis.description)}</p>` : ''}
      </div>
      ${analysis.thumb ? `<img class="result-thumb" src="${analysis.thumb}" alt="">` : ''}
    </div>

    <div class="result-total">
      <div class="kcal"><strong>${fmt(t.kcal)}</strong><span>kkal</span></div>
      <span class="muted">${t.grams ? `≈ ${fmt(t.grams)} q porsiya` : 'porsiya'}</span>
    </div>

    <div class="macros">
      ${macroCard('Zülal', t.protein, pPct)}
      ${macroCard('Karbohidrat', t.carbs, cPct)}
      ${macroCard('Yağ', t.fat, fPct)}
    </div>

    <div class="ing-head">
      <h3>Tərkibi</h3>
      <span>qramı dəyişə bilərsən</span>
    </div>
    <div class="ings">${ingredients}</div>

    <div class="result-tools">
      <button class="btn btn-outline btn-sm" id="btnAddFood" type="button">＋ Ərzaq əlavə et</button>
      <button class="btn btn-outline btn-sm" id="btnRecalc" type="button">AI ilə yenidən hesabla</button>
    </div>

    ${analysis.health ? `<div class="note">💚 ${esc(analysis.health)}</div>` : ''}
    ${analysis.notes ? `<div class="note note-soft">${esc(analysis.notes)}</div>` : ''}

    <div class="result-actions">
      ${
        editing
          ? `<button class="btn btn-primary" id="btnSaveEdit" type="button">Yadda saxla</button>
             <button class="btn btn-outline" id="btnCancelEdit" type="button">Ləğv et</button>`
          : `<button class="btn btn-primary" id="btnAddDiary" type="button" ${t.kcal > 0 ? '' : 'disabled'}>Gündəliyə əlavə et</button>
             <button class="btn btn-outline" id="btnDiscard" type="button">Sil</button>`
      }
    </div>
    <p class="disclaimer">${
      editing
        ? 'Dəyişiklikləri etdikdən sonra “Yadda saxla”nı bas.'
        : 'AI təxminidir — dəqiqlik üçün qramları düzəlt və ya AI ilə yenidən hesabla.'
    }</p>
  `;
}

function macroCard(label, grams, percent) {
  return `
    <div class="macro">
      <small>${label}</small>
      <b>${round1(grams)}<span> q</span></b>
      <div class="macro-bar"><i style="width:${clamp(percent, 0, 100)}%"></i></div>
    </div>`;
}

function ingredientRow(item, index) {
  return `
    <div class="ing">
      <div class="ing-main">
        <span class="ing-name">${esc(item.name)}</span>
        <span class="ing-macros">Z ${item.protein} · K ${item.carbs} · Y ${item.fat}</span>
      </div>
      <label class="grams">
        <input type="number" inputmode="decimal" min="1" max="3000" step="5" value="${item.grams}" data-gram="${index}" aria-label="${esc(item.name)} miqdarı, qram">
        <span>q</span>
      </label>
      <div class="ing-kcal">${fmt(item.kcal)}<span>kkal</span></div>
      <button class="ing-del" type="button" data-remove-ing="${index}" aria-label="${esc(item.name)} tərkibini sil">×</button>
    </div>`;
}

function onGramChange(event) {
  const input = event.target.closest('[data-gram]');
  if (!input || !state.analysis) return;

  const index = Number(input.dataset.gram);
  const item = state.analysis.ingredients[index];
  if (!item) return;

  const grams = clamp(num(input.value), 1, 3000);
  if (!grams) {
    input.value = item.grams;
    return;
  }

  item.grams = Math.round(grams);
  item.kcal = Math.round(item.perGram.kcal * item.grams);
  item.protein = round1(item.perGram.protein * item.grams);
  item.carbs = round1(item.perGram.carbs * item.grams);
  item.fat = round1(item.perGram.fat * item.grams);

  recomputeTotals(state.analysis);
  renderResult();
}

function onResultClick(event) {
  if (event.target.closest('#btnSaveEdit')) {
    saveEntryEdit();
    return;
  }
  if (event.target.closest('#btnCancelEdit')) {
    cancelEntryEdit();
    return;
  }
  if (event.target.closest('#btnAddDiary')) {
    addToDiary();
  } else if (event.target.closest('#btnDiscard')) {
    resetCapture();
    toast('Nəticə silindi');
  } else if (event.target.closest('#btnAddFood')) {
    openFoodSheet();
  } else if (event.target.closest('#btnRecalc')) {
    recalcWithAI();
  } else {
    const remove = event.target.closest('[data-remove-ing]');
    if (remove) removeIngredient(Number(remove.dataset.removeIng));
  }
}

function editEntry(id) {
  const entry = state.entries.find((item) => item.id === id);
  if (!entry) return;

  const ingredients = (Array.isArray(entry.ingredients) ? entry.ingredients : []).map((item) => {
    const grams = Math.max(1, Math.round(num(item.grams)));
    const kcal = Math.max(0, num(item.kcal));
    const protein = Math.max(0, num(item.protein));
    const carbs = Math.max(0, num(item.carbs));
    const fat = Math.max(0, num(item.fat));
    return {
      name: String(item.name || 'Tərkib'),
      grams,
      kcal: Math.round(kcal),
      protein: round1(protein),
      carbs: round1(carbs),
      fat: round1(fat),
      perGram: {
        kcal: kcal / grams,
        protein: protein / grams,
        carbs: carbs / grams,
        fat: fat / grams,
      },
    };
  });

  const totals = {
    kcal: Math.max(0, Math.round(num(entry.totals?.kcal))),
    protein: Math.max(0, round1(num(entry.totals?.protein))),
    carbs: Math.max(0, round1(num(entry.totals?.carbs))),
    fat: Math.max(0, round1(num(entry.totals?.fat))),
    fiber: Math.max(0, round1(num(entry.totals?.fiber))),
    grams: Math.max(0, Math.round(num(entry.totals?.grams))),
  };

  const analysis = {
    dish: entry.dish || 'Yemək',
    description: entry.description || '',
    cuisine: '',
    confidence: entry.confidence || 0,
    notes: '',
    health: '',
    ingredients,
    totals,
    thumb: entry.thumb || '',
    healthScore: entry.healthScore || 0,
  };
  if (ingredients.length) recomputeTotals(analysis);
  if (!analysis.healthScore) {
    analysis.healthScore = computeHealthScore(analysis.dish, analysis.ingredients, analysis.totals);
  }

  state.analysis = analysis;
  state.editing = entry.id;
  state.pending = { dataUrl: '', thumb: entry.thumb || '' };
  $('#resultBody').innerHTML = '';

  setTab('home');
  $('#analyzeCard').classList.add('hidden');
  $('#loadingCard').classList.add('hidden');
  $('#errorCard').classList.add('hidden');
  $('#resultCard').classList.remove('hidden');
  renderResult();
  window.setTimeout(() => {
    $('#resultCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 60);
}

function saveEntryEdit() {
  const entry = state.entries.find((item) => item.id === state.editing);
  const analysis = state.analysis;
  if (!entry || !analysis) return;

  const dish = ($('#editDish') ? $('#editDish').value : analysis.dish).trim();
  if (!dish) {
    toast('Yeməyin adını yaz');
    return;
  }
  if (!analysis.ingredients.length && analysis.totals.kcal <= 0) {
    toast('Ərzaq əlavə et və ya kalori daxil et');
    return;
  }

  entry.dish = dish;
  entry.ingredients = analysis.ingredients.map((item) => ({
    name: item.name,
    grams: item.grams,
    kcal: item.kcal,
    protein: item.protein,
    carbs: item.carbs,
    fat: item.fat,
  }));
  entry.totals = { ...analysis.totals };
  entry.thumb = analysis.thumb || entry.thumb || '';
  entry.manual = Boolean(entry.manual && !analysis.ingredients.length);
  entry.healthScore = computeHealthScore(dish, analysis.ingredients, entry.totals);
  entry.editedAt = Date.now();

  writeJSON(LS.entries, state.entries);

  resetCapture();
  renderDiary();
  renderHomeSummary();
  setTab('diary');
  toast('Yemək yeniləndi');
}

function cancelEntryEdit() {
  resetCapture();
  renderDiary();
  setTab('diary');
  toast('Redaktə ləğv edildi');
}

function removeIngredient(index) {
  const analysis = state.analysis;
  if (!analysis || !analysis.ingredients[index]) return;
  analysis.ingredients.splice(index, 1);
  analysis.aiRecalculated = false;
  recomputeTotals(analysis);
  renderResult();
  toast('Tərkib silindi');
}

/* ---------------- ərzaq bazası ---------------- */

const AZ_FOLD = { ə: 'e', ı: 'i', ö: 'o', ü: 'u', ç: 'c', ş: 's', ğ: 'g' };

function foldText(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/[əıöüçşğ]/g, (ch) => AZ_FOLD[ch] || ch);
}

/* ---------------- sağlamlıq indeksi (1–10) ---------------- */

const SCORE_CATEGORIES = [
  {
    key: 'dessert',
    base: 4,
    words: ['tort', 'keks', 'piroq', 'piroj', 'şirniyyat', 'şokolad', 'konfet', 'mürəbbə', 'bal', 'paxlava', 'dondurma', 'biskvit', 'muffin', 'donut', 'şəkər', 'krem'],
  },
  { key: 'drink', base: 2, words: ['kola', 'fanta', 'sprite', 'limonad', 'enerji', 'kompot', 'şirə', 'qazlı'] },
  {
    key: 'fastfood',
    base: 4,
    words: ['hamburger', 'pizza', 'dönər', 'döner', 'hot dog', 'çips', 'kartof fri', 'fri', 'qızard', 'nugget', 'sosis', 'kolbasa', 'vetçina', 'mayonez'],
  },
  { key: 'fat', base: 6, words: ['yağ', 'kərə yağı', 'zeytun yağı', 'günəbaxan yağı'] },
  { key: 'nuts', base: 8, words: ['qoz', 'fındıq', 'badam', 'püstə', 'küncüt'] },
  {
    key: 'salad',
    base: 9,
    words: ['salat', 'tərəvəz', 'brokoli', 'ispanaq', 'kələm', 'pomidor', 'xiyar', 'bibər', 'badımcan', 'göbələk', 'lobya', 'noxud', 'mərci', 'turşu'],
  },
  {
    key: 'fruit',
    base: 9,
    words: ['meyvə', 'alma', 'banan', 'portağal', 'üzüm', 'qarpız', 'yemiş', 'çiyələk', 'armud', 'nar', 'şaftalı', 'ərik', 'xurma', 'limon', 'avokado'],
  },
  { key: 'soup', base: 8, words: ['şorba', 'sup', 'bulyon'] },
  { key: 'grain', base: 6, words: ['düyü', 'plov', 'bulqur', 'qarabaşaq', 'yulaf', 'makaron', 'çörək', 'lavash', 'kartof', 'pide'] },
  {
    key: 'protein',
    base: 8,
    words: ['toyuq', 'balıq', 'qızılbalıq', 'xək', 'karp', 'yumurta', 'kəsmik', 'qatıq', 'kefir', 'süd', 'karides', 'dana', 'mal əti', 'kabab'],
  },
];

function matchScoreCategory(text, tokens) {
  for (const category of SCORE_CATEGORIES) {
    for (const word of category.words) {
      const normalized = foldText(word);
      if (normalized.includes(' ')) {
        if (text.includes(normalized)) return category;
      } else if (normalized.length <= 3) {
        if (tokens.includes(normalized)) return category;
      } else if (tokens.some((token) => token === normalized || token.startsWith(normalized))) {
        return category;
      }
    }
  }
  return null;
}

function computeHealthScore(dish, ingredients, totals) {
  if (!totals) return 0;
  const kcal = Math.max(0, num(totals.kcal));
  if (kcal <= 0) return 0;

  const names = (Array.isArray(ingredients) ? ingredients : [])
    .map((item) => (item && item.name) || '')
    .join(' ');
  const text = foldText(`${dish || ''} ${names}`);
  const tokens = text.split(/[^a-z0-9]+/).filter(Boolean);
  const dishText = foldText(dish || '');
  const dishTokens = dishText.split(/[^a-z0-9]+/).filter(Boolean);

  // əvvəl yeməyin adına bax; adadan kategoriya tapılmasa, tərkibə bax
  const category =
    matchScoreCategory(dishText, dishTokens) ||
    matchScoreCategory(text, tokens) || { key: 'mixed', base: 6, words: [] };

  let score = category.base;

  const protein = Math.max(0, num(totals.protein));
  const carbs = Math.max(0, num(totals.carbs));
  const fat = Math.max(0, num(totals.fat));
  const pShare = (protein * 4) / kcal;
  const cShare = (carbs * 4) / kcal;
  const fShare = (fat * 9) / kcal;
  const grams = Math.max(0, num(totals.grams));
  const density = grams > 0 ? (kcal / grams) * 100 : 0;

  const lightCategory = ['dessert', 'drink', 'fruit', 'salad', 'nuts', 'fat'].includes(category.key);

  if (!lightCategory) {
    if (pShare >= 0.25) score += 1;
    else if (pShare < 0.08) score -= 1;
  }

  if (category.key !== 'nuts' && category.key !== 'fat') {
    if (fShare >= 0.5) score -= 2;
    else if (fShare >= 0.38) score -= 1;
  }

  if (category.key !== 'nuts' && category.key !== 'fat') {
    if (density >= 550) score -= 2;
    else if (density >= 400) score -= 1;
  }

  if (density > 0 && density <= 80 && ['salad', 'fruit', 'soup'].includes(category.key)) {
    score += 1;
  }

  if (['dessert', 'drink', 'fastfood'].includes(category.key) && cShare >= 0.55) {
    score -= 1;
  }

  return clamp(Math.round(score), 1, 10);
}

function scoreBand(score) {
  if (score >= 8) return 'high';
  if (score >= 5) return 'mid';
  return 'low';
}

function scoreLabel(score) {
  if (score >= 9) return 'Əla';
  if (score >= 7) return 'Yaxşı';
  if (score >= 5) return 'Orta';
  if (score >= 3) return 'Zəif';
  return 'Çox zəif';
}

function entryHealthScore(entry) {
  return entry.healthScore || computeHealthScore(entry.dish, entry.ingredients, entry.totals);
}

function renderFoodList(query = '') {
  const q = foldText(query.trim());
  const items = FOOD_DB.filter((item) => !q || foldText(item.n).includes(q)).slice(0, 80);

  if (!items.length) {
    $('#foodList').innerHTML = '<div class="empty">Tapılmadı. Aşağıdan “özün yaz” ilə əlavə et.</div>';
    return;
  }

  $('#foodList').innerHTML = items
    .map(
      (item, index) => `<button class="food-row" type="button" data-food-index="${FOOD_DB.indexOf(item)}">
        <span class="food-name">${esc(item.n)}</span>
        <span class="food-meta">${Math.round(item.k)} kkal · 100 q</span>
      </button>`
    )
    .join('');
}

function openFoodSheet() {
  if (!state.analysis) return;
  $('#foodSheet').classList.remove('hidden');
  document.body.classList.add('locked');
  $('#foodSearch').value = '';
  $('#foodSearch').classList.remove('hidden');
  $('#foodList').classList.remove('hidden');
  $('#foodCustomForm').classList.add('hidden');
  $('#foodCustomBtn').classList.remove('hidden');
  renderFoodList('');
  setTimeout(() => $('#foodSearch').focus(), 150);
}

function closeFoodSheet() {
  $('#foodSheet').classList.add('hidden');
  document.body.classList.remove('locked');
  $('#foodCustomForm').reset();
  $('#foodCustomForm').classList.add('hidden');
  $('#foodCustomBtn').classList.remove('hidden');
  $('#foodSearch').classList.remove('hidden');
  $('#foodList').classList.remove('hidden');
  const submit = $('#fcSubmit');
  if (submit) {
    submit.disabled = false;
    submit.textContent = 'Əlavə et';
  }
}

function onFoodListClick(event) {
  const row = event.target.closest('[data-food-index]');
  if (!row) return;
  const item = FOOD_DB[Number(row.dataset.foodIndex)];
  if (!item) return;
  addFoodItem(item, 100);
}

function addFoodItem(item, grams) {
  const analysis = state.analysis;
  if (!analysis) return;

  const g = Math.max(1, Math.round(grams || 100));
  const kcal = (item.k * g) / 100;
  const protein = (item.p * g) / 100;
  const carbs = (item.c * g) / 100;
  const fat = (item.f * g) / 100;

  analysis.ingredients.push({
    name: item.n,
    grams: g,
    kcal: Math.round(kcal),
    protein: round1(protein),
    carbs: round1(carbs),
    fat: round1(fat),
    perGram: { kcal: item.k / 100, protein: item.p / 100, carbs: item.c / 100, fat: item.f / 100 },
  });
  analysis.aiRecalculated = false;

  recomputeTotals(analysis);
  renderResult();
  closeFoodSheet();
  toast(`${item.n} əlavə olundu (${g} q)`);
}

function toggleCustomFood() {
  $('#foodCustomBtn').classList.add('hidden');
  $('#foodSearch').classList.add('hidden');
  $('#foodList').classList.add('hidden');
  $('#foodCustomForm').classList.remove('hidden');
  $('#fcName').focus();
}

function backToFoodList() {
  $('#foodCustomForm').classList.add('hidden');
  $('#foodCustomBtn').classList.remove('hidden');
  $('#foodSearch').classList.remove('hidden');
  $('#foodList').classList.remove('hidden');
  $('#foodSearch').focus();
}

async function onCustomFoodSubmit(event) {
  event.preventDefault();

  const name = $('#fcName').value.trim();
  const grams = clamp(Math.round(num($('#fcGrams').value) || 100), 1, 3000);
  if (!name) {
    toast('Ərzağın adını yaz');
    return;
  }

  let kcal100 = Math.max(0, num($('#fcKcal').value));
  let protein100 = Math.max(0, num($('#fcProtein').value));
  let carbs100 = Math.max(0, num($('#fcCarbs').value));
  let fat100 = Math.max(0, num($('#fcFat').value));

  if (kcal100 > 0) {
    addFoodItem({ n: name, k: kcal100, p: protein100, c: carbs100, f: fat100 }, grams);
    return;
  }

  if (!activeApiKey()) {
    toast('AI açarı yoxdur — kalori sütununu əl ilə doldur');
    return;
  }

  const button = $('#fcSubmit');
  button.disabled = true;
  button.textContent = 'AI hesablayır…';

  try {
    const estimate = await estimateFoodNutrition(name);
    if ($('#foodSheet').classList.contains('hidden')) return;
    kcal100 = estimate.kcal100;
    protein100 = estimate.protein100;
    carbs100 = estimate.carbs100;
    fat100 = estimate.fat100;
    addFoodItem({ n: name, k: kcal100, p: protein100, c: carbs100, f: fat100 }, grams);
  } catch (err) {
    console.error(err);
    toast(err instanceof AppError ? err.message : 'AI təxmin edə bilmədi');
  } finally {
    button.disabled = false;
    button.textContent = 'Əlavə et';
  }
}

async function estimateFoodNutrition(name) {
  const prompt = `Sən qida dəyəri hesablayan köməkçisən. “${name}” üçün 100 qramın təxmini qida dəyərini ver.

Qaydalar:
- Azərbaycan dilində yalnız JSON qaytar.
- kcal100, protein100, carbs100, fat100 — 100 qram üçün.
- 4 kkal/q zülal, 4 kkal/q karbohidrat, 9 kkal/q yağ.`;

  const raw = await geminiRequest([{ text: prompt }], FOOD_ESTIMATE_SCHEMA, state.settings);
  const kcal100 = Math.max(0, num(raw && raw.kcal100));
  if (kcal100 <= 0) {
    throw new AppError('AI kalori təxmin edə bilmədi. Kalori sütununu əl ilə doldur.');
  }

  return {
    kcal100,
    protein100: Math.max(0, num(raw && raw.protein100)),
    carbs100: Math.max(0, num(raw && raw.carbs100)),
    fat100: Math.max(0, num(raw && raw.fat100)),
  };
}

/* ---------------- AI ilə yenidən hesablama ---------------- */

async function recalcWithAI() {
  const analysis = state.analysis;
  if (!analysis) return;
  if (!analysis.ingredients.length) {
    toast('Əvvəlcə ərzaq əlavə et');
    return;
  }

  const button = $('#btnRecalc');
  if (button) {
    button.disabled = true;
    button.textContent = 'Hesablanır…';
  }

  try {
    const nameInput = $('#editDish');
    if (nameInput && nameInput.value.trim()) analysis.dish = nameInput.value.trim();

    const lines = analysis.ingredients.map((item, index) => `${index + 1}. ${item.name} — ${item.grams} q`).join('\n');
    const prompt = `Sən qida dəyəri hesablayan köməkçisən.

Yemək: ${analysis.dish}
Tərkib:
${lines}

Bu tərkib üçün hər məhsulun kalorisini, zülalını, karbohidratını və yağını hesabla.

Qaydalar:
- Adları, qramları və sıranı dəyişmə.
- Hər məhsul üçün göstərilən qram miqdarına uyğun dəyər ver.
- 4 kkal/q zülal, 4 kkal/q karbohidrat, 9 kkal/q yağ istifadə et.
- Azərbaycan dilində yalnız JSON qaytar.`;

    const raw = await geminiRequest([{ text: prompt }], RECALC_SCHEMA, state.settings);
    applyRecalc(raw);
    toast('AI yenidən hesabladı');
  } catch (err) {
    console.error(err);
    toast(err instanceof AppError ? err.message : 'Yenidən hesablama alınmadı');
  } finally {
    if (state.analysis) renderResult();
  }
}

function applyRecalc(raw) {
  const analysis = state.analysis;
  if (!analysis) return;
  const list = Array.isArray(raw && raw.ingredients) ? raw.ingredients : [];

  analysis.ingredients.forEach((item, index) => {
    const byIndex = list[index];
    const byName = list.find((x) => foldText(x.name) === foldText(item.name));
    const src = byIndex && foldText(byIndex.name) === foldText(item.name) ? byIndex : byName || byIndex;
    if (!src) return;

    const grams = item.grams;
    const protein = Math.max(0, num(src.protein));
    const carbs = Math.max(0, num(src.carbs));
    const fat = Math.max(0, num(src.fat));
    let kcal = Math.max(0, num(src.kcal));
    if (!kcal && (protein || carbs || fat)) kcal = protein * 4 + carbs * 4 + fat * 9;

    item.protein = round1(protein);
    item.carbs = round1(carbs);
    item.fat = round1(fat);
    item.kcal = Math.round(kcal);
    item.perGram = {
      kcal: kcal / grams,
      protein: protein / grams,
      carbs: carbs / grams,
      fat: fat / grams,
    };
  });

  analysis.aiRecalculated = true;
  recomputeTotals(analysis);
}

function addToDiary() {
  const analysis = state.analysis;
  if (!analysis) return;

  const entry = {
    id: uid(),
    ts: Date.now(),
    date: dateKey(),
    dish: analysis.dish,
    description: analysis.description,
    confidence: analysis.confidence,
    thumb: (state.pending && state.pending.thumb) || '',
    ingredients: analysis.ingredients.map((item) => ({
      name: item.name,
      grams: item.grams,
      kcal: item.kcal,
      protein: item.protein,
      carbs: item.carbs,
      fat: item.fat,
    })),
    totals: { ...analysis.totals },
    healthScore: analysis.healthScore || computeHealthScore(analysis.dish, analysis.ingredients, analysis.totals),
  };

  state.entries.push(entry);
  writeJSON(LS.entries, state.entries);

  resetCapture();
  renderDiary();
  renderHomeSummary();
  setTab('diary');
  toast('Gündəliyə əlavə olundu');
}

function loadSample() {
  state.pending = { dataUrl: '', thumb: '' };
  state.analysis = normalizeAnalysis(SAMPLE);
  state.analysis.thumb = '';
  state.editing = null;
  renderResult();
  $('#analyzeCard').classList.add('hidden');
  $('#errorCard').classList.add('hidden');
  $('#loadingCard').classList.add('hidden');
  $('#resultCard').classList.remove('hidden');
  $('#resultCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  toast('Bu, nümunə nəticədir');
}

/* ---------------- home summary ---------------- */

function sumTotals(entries) {
  const total = { kcal: 0, protein: 0, carbs: 0, fat: 0, grams: 0 };
  for (const entry of entries) {
    const t = entry.totals || {};
    total.kcal += num(t.kcal);
    total.protein += num(t.protein);
    total.carbs += num(t.carbs);
    total.fat += num(t.fat);
    total.grams += num(t.grams);
  }
  total.kcal = Math.round(total.kcal);
  total.protein = round1(total.protein);
  total.carbs = round1(total.carbs);
  total.fat = round1(total.fat);
  total.grams = Math.round(total.grams);
  return total;
}

function ringSVG(size, stroke, progress, id) {
  const radius = (size - stroke) / 2;
  const circumference = 2 * Math.PI * radius;
  const filled = circumference * clamp(progress, 0, 1);
  return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" aria-hidden="true">
    <defs>
      <linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#BEF264"></stop>
        <stop offset="1" stop-color="#16A34A"></stop>
      </linearGradient>
    </defs>
    <circle cx="${size / 2}" cy="${size / 2}" r="${radius}" fill="none" stroke="var(--line)" stroke-width="${stroke}"></circle>
    <circle cx="${size / 2}" cy="${size / 2}" r="${radius}" fill="none" stroke="url(#${id})" stroke-width="${stroke}" stroke-linecap="${progress > 0 ? 'round' : 'butt'}"
      stroke-dasharray="${filled} ${circumference}" transform="rotate(-90 ${size / 2} ${size / 2})"></circle>
  </svg>`;
}

function renderHomeSummary() {
  const prompt = $('#profilePrompt');
  if (prompt) prompt.classList.toggle('hidden', Boolean(state.settings.profile));
  const today = state.entries.filter((entry) => entry.date === dateKey());
  const totals = sumTotals(today);
  const goal = state.settings.goal;
  const pct = clamp(totals.kcal / goal, 0, 1);
  const remaining = goal - totals.kcal;

  $('#homeSummary').innerHTML = `
    <div>
      <span class="label">Bugün</span>
      <div class="sum-kcal">
        <strong>${fmt(totals.kcal)}</strong>
        <span>/ ${fmt(goal)} kkal</span>
      </div>
      <div class="sum-macros">Z ${totals.protein} · K ${totals.carbs} · Y ${totals.fat}</div>
      <button class="link-btn" type="button" data-tab="diary" style="margin-top:8px">
        ${remaining >= 0 ? `${fmt(remaining)} kkal qalıb` : `${fmt(Math.abs(remaining))} kkal artıq`} →
      </button>
    </div>
    <div class="ring-wrap">
      ${ringSVG(88, 9, pct, 'ringHome')}
      <div class="ring-label"><strong>${Math.round(pct * 100)}%</strong><span>hədəf</span></div>
    </div>`;
}

function renderAiStatus() {
  const el = $('#aiStatus');
  if (!el) return;
  if (activeApiKey()) {
    el.className = 'status-btn ok';
    el.textContent = 'Google Gemini hazır';
  } else {
    el.className = 'status-btn';
    el.textContent = 'AI açarını qoş →';
  }
}

/* ---------------- diary ---------------- */

function selectedDate() {
  return state.selectedDate || dateKey();
}

function selectDate(key) {
  if (!key || key > dateKey()) return;
  state.selectedDate = key;
  renderDiary();
}

function shiftDay(delta) {
  const d = new Date(`${selectedDate()}T12:00:00`);
  d.setDate(d.getDate() + delta);
  selectDate(dateKey(d));
}

function macroTargets(goal) {
  const kcal = clamp(Math.round(num(goal) || 2000), 800, 8000);
  const profile = state.settings.profile;
  if (profile) return { kcal, ...profileMacros(profile, kcal), personal: true };
  return {
    kcal,
    protein: Math.round((kcal * DEFAULT_SPLIT.protein) / 4),
    carbs: Math.round((kcal * DEFAULT_SPLIT.carbs) / 4),
    fat: Math.round((kcal * DEFAULT_SPLIT.fat) / 9),
    personal: false,
  };
}

function renderMacroTargets(totals, goal) {
  const target = macroTargets(goal);
  const splitEl = $('#macroSplit');
  if (splitEl) splitEl.textContent = target.personal ? 'Profilinə görə' : '25% / 45% / 30%';
  const rows = [
    { label: 'Zülal', value: totals.protein, target: target.protein },
    { label: 'Karbohidrat', value: totals.carbs, target: target.carbs },
    { label: 'Yağ', value: totals.fat, target: target.fat },
  ];

  $('#macroList').innerHTML = rows
    .map((row) => {
      const pct = row.target > 0 ? clamp((row.value / row.target) * 100, 0, 100) : 0;
      const diff = round1(row.target - row.value);
      const over = diff < 0;
      return `<div class="macro-line">
        <div class="macro-line-top">
          <span>${row.label}</span>
          <b>${round1(row.value)} / ${row.target} q</b>
        </div>
        <div class="macro-line-bar"><i class="${over ? 'over' : ''}" style="width:${pct}%"></i></div>
        <div class="macro-line-note ${over ? 'over' : ''}">${over ? `${round1(-diff)} q artıq` : `${diff} q qalıb`}</div>
      </div>`;
    })
    .join('');
}

function renderDiary() {
  const key = selectedDate();
  const dayEntries = state.entries.filter((entry) => entry.date === key).sort((a, b) => b.ts - a.ts);
  const totals = sumTotals(dayEntries);
  const goal = state.settings.goal;
  const pct = clamp(totals.kcal / goal, 0, 1);
  const remaining = goal - totals.kcal;
  const over = remaining < 0;
  const isToday = key === dateKey();

  $('#dayTitle').textContent = dayLabel(key);
  $('#daySub').textContent = shortDate(key);
  $('#dayNext').disabled = key >= dateKey();
  $('#btnToday').classList.toggle('hidden', isToday);

  $('#diaryRing').innerHTML = `
    <div class="ring-big">
      ${ringSVG(148, 13, pct, 'ringDiary')}
      <div class="ring-center"><strong>${fmt(totals.kcal)}</strong><span>/ ${fmt(goal)} kkal</span></div>
    </div>
    <div class="ring-stats">
      <div class="stat"><span>Qəbul</span><b>${fmt(totals.kcal)} kkal</b></div>
      <div class="stat"><span>Hədəf</span><b>${fmt(goal)} kkal</b></div>
      <div class="stat"><span>${over ? 'Artıq' : 'Qalan'}</span>
        <b style="color:${over ? 'var(--danger)' : 'var(--brand)'}">${fmt(Math.abs(remaining))} kkal</b>
      </div>
    </div>`;

  renderMacroTargets(totals, goal);
  renderWeek();
  renderDayEntries(dayEntries, key);
  renderDaysList();
}

function renderWeek() {
  const goal = state.settings.goal;
  const selected = selectedDate();
  const days = [];

  for (let i = 6; i >= 0; i--) {
    const d = new Date();
    d.setHours(12, 0, 0, 0);
    d.setDate(d.getDate() - i);
    const key = dateKey(d);
    days.push({
      d,
      key,
      kcal: sumTotals(state.entries.filter((entry) => entry.date === key)).kcal,
    });
  }

  const max = Math.max(goal, ...days.map((day) => day.kcal), 1);
  const total = days.reduce((sum, day) => sum + day.kcal, 0);
  $('#weekMeta').textContent = `7 gündə ${fmt(total)} kkal`;

  $('#weekChart').innerHTML = days
    .map((day) => {
      const height = day.kcal ? Math.max(4, Math.round((day.kcal / max) * 100)) : 0;
      const isSelected = day.key === selected;
      return `<button class="bar-col ${isSelected ? 'selected' : ''}" type="button" data-day="${day.key}" aria-label="${shortDate(day.key)}: ${fmt(day.kcal)} kkal">
        <div class="bar-track">
          <div class="bar ${day.kcal ? '' : 'empty'} ${day.key === dateKey() ? 'today' : ''}" style="height:${height}%"></div>
        </div>
        <span class="bar-label">${WD[day.d.getDay()]}</span>
      </button>`;
    })
    .join('');
}

function renderDayEntries(entries, key) {
  const isToday = key === dateKey();
  $('#todayCard').innerHTML = `
    <div class="card-head">
      <h3>${isToday ? 'Bugünkü yeməklər' : `${esc(dayLabel(key))} — yeməklər`}</h3>
      <span class="muted">${entries.length} qeyd</span>
    </div>
    ${
      entries.length
        ? entries.map(entryRow).join('')
        : `<div class="empty">Bu gün üçün qeyd yoxdur.${
            isToday ? '<br>Şəkil çək və ya “+ Əl ilə” əlavə et.' : ''
          }</div>`
    }`;
}

function renderDaysList() {
  const groups = groupByDate(state.entries).slice(0, 60);
  const card = $('#daysCard');

  if (!groups.length) {
    card.classList.add('hidden');
    card.innerHTML = '';
    return;
  }

  card.classList.remove('hidden');
  const selected = selectedDate();
  card.innerHTML = `
    <div class="card-head">
      <h3>Günlər</h3>
      <span class="muted">${groups.length} gün</span>
    </div>
    ${groups
      .map(([key, items]) => {
        const total = sumTotals(items);
        return `<button class="day-row ${key === selected ? 'active' : ''}" type="button" data-day="${key}">
          <span class="day-row-main">
            <b>${esc(dayLabel(key))}</b>
            <small>${esc(shortDate(key))}</small>
          </span>
          <span class="day-row-kcal">${fmt(total.kcal)} kkal<small>${items.length} qeyd</small></span>
        </button>`;
      })
      .join('')}`;
}

function groupByDate(entries) {
  const map = new Map();
  for (const entry of entries) {
    const key = entry.date || dateKey(new Date(entry.ts || Date.now()));
    if (!map.has(key)) map.set(key, []);
    map.get(key).push(entry);
  }
  return Array.from(map.entries()).sort((a, b) => b[0].localeCompare(a[0]));
}

function dayLabel(key) {
  const today = dateKey();
  const yesterday = dateKey(new Date(Date.now() - 86400000));
  if (key === today) return 'Bugün';
  if (key === yesterday) return 'Dünən';
  const d = new Date(`${key}T12:00:00`);
  if (isNaN(d.getTime())) return key;
  return `${d.getDate()} ${AZ_MONTHS[d.getMonth()]}`;
}

function shortDate(key) {
  const d = new Date(`${key}T12:00:00`);
  if (isNaN(d.getTime())) return key;
  const sameYear = d.getFullYear() === new Date().getFullYear();
  return `${d.getDate()} ${AZ_MONTHS[d.getMonth()]}${sameYear ? '' : ` ${d.getFullYear()}`}, ${AZ_WEEKDAYS[d.getDay()]}`;
}

function entryRow(entry) {
  const totals = entry.totals || {};
  const grams = num(totals.grams);
  const parts = [];
  const time = formatTime(entry.ts);
  if (time) parts.push(time);
  if (grams) parts.push(`${fmt(grams)} q`);
  if (entry.manual) parts.push('əl ilə');
  const expanded = state.expanded.has(entry.id);
  const score = entryHealthScore(entry);

  return `<div class="entry-wrap">
    <div class="entry">
      ${
        entry.thumb
          ? `<img src="${entry.thumb}" alt="">`
          : `<div class="entry-ph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3.4"></circle></svg></div>`
      }
      <div class="entry-main" data-expand="${esc(entry.id)}" role="button" tabindex="0" aria-expanded="${expanded}">
        <div class="entry-body">
          <div class="entry-name">${esc(entry.dish || 'Yemək')}</div>
          <div class="entry-meta">${esc(parts.join(' · '))}${
            score ? ` <span class="score-mini score-${scoreBand(score)}">${score}/10</span>` : ''
          }</div>
        </div>
        <div class="entry-kcal">${fmt(totals.kcal)}<span>kkal</span></div>
      </div>
      <button class="entry-edit" type="button" data-edit="${esc(entry.id)}" aria-label="Yeməyi redaktə et">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
      </button>
      <button class="entry-del" type="button" data-del="${esc(entry.id)}" aria-label="Qeydi sil">×</button>
    </div>
    ${expanded ? entryDetail(entry) : ''}
  </div>`;
}

function entryDetail(entry) {
  const items = Array.isArray(entry.ingredients) ? entry.ingredients : [];
  const totals = entry.totals || {};
  const score = entryHealthScore(entry);
  const list = items.length
    ? `<ul class="entry-ings">${items
        .map(
          (item) =>
            `<li><span>${esc(item.name)}</span><span>${fmt(item.grams)} q</span><span>${fmt(item.kcal)} kkal</span></li>`
        )
        .join('')}</ul>`
    : '<p class="muted">Tərkib qeyd edilməyib.</p>';

  return `<div class="entry-detail">
    ${
      score
        ? `<div class="entry-score"><span class="score-mini score-${scoreBand(score)}">Sağlamlıq ${score}/10</span><span>${scoreLabel(score)}</span></div>`
        : ''
    }
    ${list}
    <div class="entry-macros">Z ${round1(totals.protein)} · K ${round1(totals.carbs)} · Y ${round1(totals.fat)}</div>
  </div>`;
}

function toggleEntryDetails(id) {
  if (state.expanded.has(id)) state.expanded.delete(id);
  else state.expanded.add(id);
  renderDiary();
}

function formatTime(ts) {
  if (!ts) return '';
  const d = new Date(ts);
  if (isNaN(d.getTime())) return '';
  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
}

function removeEntry(id) {
  const entry = state.entries.find((item) => item.id === id);
  if (!entry) return;
  if (!confirm(`“${entry.dish}” qeydi silinsin?`)) return;

  state.entries = state.entries.filter((item) => item.id !== id);
  state.expanded.delete(id);
  writeJSON(LS.entries, state.entries);
  renderDiary();
  renderHomeSummary();
  toast('Qeyd silindi');
}

/* ---------------- manual entry ---------------- */

function onManualSubmit(event) {
  event.preventDefault();

  const dish = $('#mName').value.trim();
  const kcal = Math.round(num($('#mKcal').value));
  if (!dish) {
    toast('Yeməyin adını yaz');
    return;
  }
  if (kcal <= 0) {
    toast('Kalori dəyərini yaz');
    return;
  }

  const entry = {
    id: uid(),
    ts: Date.now(),
    date: dateKey(),
    dish,
    manual: true,
    thumb: '',
    ingredients: [],
    totals: {
      kcal,
      protein: Math.max(0, round1(num($('#mProtein').value))),
      carbs: Math.max(0, round1(num($('#mCarbs').value))),
      fat: Math.max(0, round1(num($('#mFat').value))),
      grams: 0,
    },
  };

  entry.healthScore = computeHealthScore(entry.dish, entry.ingredients, entry.totals);

  state.entries.push(entry);
  writeJSON(LS.entries, state.entries);

  $('#manualForm').reset();
  $('#manualCard').classList.add('hidden');
  renderDiary();
  renderHomeSummary();
  toast('Əlavə olundu');
}

/* ---------------- settings ---------------- */

function fillSettings() {
  const s = state.settings;
  $('#setGoal').value = s.goal;
  $('#setModel').value = s.model;
  $('#modelSelectWrap').classList.add('hidden');
  $('#modelStatus').textContent = '';
  $('#keySetup').classList.toggle('hidden', Boolean(CONFIG.geminiApiKey));
  $('#setKey').value = s.apiKey || '';
  updateGoalMacros();
  fillProfileForm();
  applyTheme(s.theme);
}

function updateGoalMacros() {
  const target = macroTargets($('#setGoal').value);
  $('#goalMacros').textContent = `Norma: zülal ${target.protein} q · karbohidrat ${target.carbs} q · yağ ${target.fat} q ${
    target.personal ? '(profilinə görə, zülal çəkiyə əsasən)' : '(25% / 45% / 30%)'
  }`;
}

function onThemeChoice(event) {
  const btn = event.target.closest('[data-theme-opt]');
  if (!btn) return;
  const theme = btn.dataset.themeOpt;
  if (!['auto', 'light', 'dark'].includes(theme)) return;
  state.settings.theme = theme;
  writeJSON(LS.settings, state.settings);
  applyTheme(theme);
}

function applyTheme(theme) {
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const dark = theme === 'dark' || (theme !== 'light' && prefersDark);

  if (theme === 'auto') document.documentElement.removeAttribute('data-theme');
  else document.documentElement.dataset.theme = theme;

  const meta = document.querySelector('meta[name="theme-color"]');
  if (meta) meta.setAttribute('content', dark ? '#070b0a' : '#f2f5f3');

  $$('#themeSwitch [data-theme-opt]').forEach((btn) => {
    btn.classList.toggle('active', btn.dataset.themeOpt === theme);
  });
}

function bindSystemTheme() {
  const query = window.matchMedia('(prefers-color-scheme: dark)');
  const handler = () => {
    if (state.settings.theme === 'auto') applyTheme('auto');
  };
  if (query.addEventListener) query.addEventListener('change', handler);
  else if (query.addListener) query.addListener(handler);
}

async function loadGeminiModels() {
  const key = activeApiKey();
  if (!key) {
    toast('Əvvəlcə AI açarını əlavə et');
    return;
  }

  const button = $('#btnFetchModels');
  const status = $('#modelStatus');
  button.disabled = true;
  status.textContent = 'Gətirilir…';

  try {
    const res = await request(
      `https://generativelanguage.googleapis.com/v1beta/models?key=${encodeURIComponent(key)}&pageSize=1000`,
      { method: 'GET' },
      25000
    );
    if (!res.ok) throw await apiError(res);
    const data = await res.json();

    const blocked = ['tts', 'image', 'lyria', 'robotics', 'computer-use', 'deep-research', 'antigravity', 'transcribe', 'nano-banana'];
    const models = (data.models || [])
      .filter((model) => (model.supportedGenerationMethods || []).includes('generateContent'))
      .map((model) => ({
        id: String(model.name || '').replace('models/', ''),
        label: String(model.displayName || model.name || ''),
      }))
      .filter(
        (model) => model.id && !blocked.some((word) => `${model.id} ${model.label}`.toLowerCase().includes(word))
      )
      .sort((a, b) => {
        const ai = GEMINI_FALLBACKS.indexOf(a.id);
        const bi = GEMINI_FALLBACKS.indexOf(b.id);
        if (ai !== -1 || bi !== -1) return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
        return a.id.localeCompare(b.id);
      });

    if (!models.length) throw new AppError('Bu açar üçün uyğun model tapılmadı.');

    const select = $('#modelSelect');
    select.innerHTML = models
      .map((model) => `<option value="${esc(model.id)}">${esc(model.label)} — ${esc(model.id)}</option>`)
      .join('');

    const current = $('#setModel').value.trim();
    if (models.some((model) => model.id === current)) select.value = current;

    select.onchange = () => {
      $('#setModel').value = select.value;
      status.textContent = 'Model seçildi — Yadda saxla';
    };

    $('#modelSelectWrap').classList.remove('hidden');
    status.textContent = `${models.length} model tapıldı`;
  } catch (err) {
    console.error(err);
    status.textContent = '';
    toast(err instanceof AppError ? err.message : 'Modelləri gətirmək alınmadı');
  } finally {
    button.disabled = false;
  }
}

function onSaveSettings(event) {
  event.preventDefault();

  const goal = clamp(Math.round(num($('#setGoal').value) || 2000), 800, 8000);
  const model = $('#setModel').value.trim() || AI.model;

  if (!CONFIG.geminiApiKey) {
    const key = $('#setKey').value.trim();
    if (key) state.settings.apiKey = key;
  }

  state.settings.goal = goal;
  state.settings.model = model;
  writeJSON(LS.settings, state.settings);

  renderAiStatus();
  renderHomeSummary();
  renderDiary();
  toast('Ayarlar saxlanıldı');
}

function renderVersion() {
  const el = $('#appVersion');
  if (el) el.textContent = APP_VERSION;
}

async function forceUpdate() {
  if (!confirm('Proqram yenilənsin? Qeydlər və ayarlar silinmir.')) return;

  try {
    if ('serviceWorker' in navigator) {
      const registrations = await navigator.serviceWorker.getRegistrations();
      await Promise.all(registrations.map((registration) => registration.unregister()));
    }
  } catch (err) {
    console.warn(err);
  }

  try {
    if (window.caches) {
      const keys = await caches.keys();
      await Promise.all(keys.map((key) => caches.delete(key)));
    }
  } catch (err) {
    console.warn(err);
  }

  const url = new URL(location.href);
  url.searchParams.set('v', Date.now().toString());
  location.replace(url.toString());
}

function wipeData() {
  if (!confirm('Bütün qeydlər və ayarlar silinsin?')) return;
  [LS.settings, LS.entries, LS.iosHint].forEach((key) => localStorage.removeItem(key));
  location.reload();
}

/* ---------------- ehtiyat nüsxə ---------------- */

const BACKUP_PREFIX = 'KALORI1:';

function encodeBase64Utf8(text) {
  const bytes = new TextEncoder().encode(text);
  let binary = '';
  const chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) {
    binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
  }
  return btoa(binary);
}

function decodeBase64Utf8(value) {
  const binary = atob(value);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
  return new TextDecoder().decode(bytes);
}

function buildBackupPayload() {
  return {
    v: 1,
    exportedAt: new Date().toISOString(),
    settings: {
      goal: state.settings.goal,
      theme: state.settings.theme,
      model: state.settings.model,
      profile: state.settings.profile || null,
    },
    entries: state.entries.map((entry) => ({
      id: entry.id,
      ts: entry.ts,
      date: entry.date,
      dish: entry.dish,
      description: entry.description || '',
      confidence: entry.confidence || 0,
      ingredients: Array.isArray(entry.ingredients) ? entry.ingredients : [],
      totals: entry.totals || {},
      healthScore: entry.healthScore || 0,
      manual: Boolean(entry.manual),
      editedAt: entry.editedAt || 0,
    })),
  };
}

function buildBackupCode() {
  return BACKUP_PREFIX + encodeBase64Utf8(JSON.stringify(buildBackupPayload()));
}

async function copyBackupCode() {
  const code = buildBackupCode();
  const box = $('#backupCode');
  box.value = code;
  box.scrollTop = 0;
  box.scrollLeft = 0;

  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(code);
    } else {
      document.execCommand('copy');
    }
    toast(`Kopyalandı (${code.length} simvol)`);
  } catch (err) {
    console.warn(err);
    box.focus();
    box.setSelectionRange(0, code.length);
    toast('Kopyalanmadı — kodu əl ilə seçib kopyala');
  }
}

function parseBackupCode(input) {
  let raw = String(input || '').replace(/[\u200b-\u200d\ufeff]/gi, '').trim();
  raw = raw.replace(/%3a/gi, ':');

  const marker = raw.toUpperCase().indexOf('KALORI1');
  if (marker === -1) {
    throw new AppError('Kod “KALORI1:” ilə başlamalıdır. Tam kopyalandığını yoxla.');
  }

  let rest = raw.slice(marker + 7);
  if (rest.startsWith(':')) rest = rest.slice(1);

  let body = rest.replace(/[^A-Za-z0-9+/=]/g, '');
  if (!body) throw new AppError('Kodun məzmunu boşdur.');

  const pad = body.length % 4;
  if (pad) body += '='.repeat(4 - pad);

  let json;
  try {
    json = decodeBase64Utf8(body);
  } catch {
    throw new AppError('Kod oxunmadı. Tam kopyalandığını yoxla.');
  }

  let payload;
  try {
    payload = JSON.parse(json);
  } catch {
    throw new AppError('Kod natamamdır. Yenidən kopyala və ya fayl ilə bərpa et.');
  }

  if (!payload || !Array.isArray(payload.entries)) {
    throw new AppError('Kodda qeydlər tapılmadı.');
  }

  return payload;
}

function applyBackupPayload(payload) {
  const map = new Map(state.entries.map((entry) => [entry.id, entry]));
  let restored = 0;

  for (const item of payload.entries.slice(0, 5000)) {
    if (!item || !item.id || !item.date || !item.dish) continue;
    if (!/^\d{4}-\d{2}-\d{2}$/.test(String(item.date).slice(0, 10))) continue;

    const ingredients = (Array.isArray(item.ingredients) ? item.ingredients : [])
      .slice(0, 40)
      .map((ing) => {
        const grams = Math.max(1, Math.round(num(ing && ing.grams)));
        return {
          name: String((ing && ing.name) || 'Tərkib').slice(0, 80),
          grams,
          kcal: Math.max(0, Math.round(num(ing && ing.kcal))),
          protein: Math.max(0, round1(num(ing && ing.protein))),
          carbs: Math.max(0, round1(num(ing && ing.carbs))),
          fat: Math.max(0, round1(num(ing && ing.fat))),
        };
      })
      .filter((ing) => ing.grams > 0);

    const totals = {
      kcal: Math.max(0, Math.round(num(item.totals && item.totals.kcal))),
      protein: Math.max(0, round1(num(item.totals && item.totals.protein))),
      carbs: Math.max(0, round1(num(item.totals && item.totals.carbs))),
      fat: Math.max(0, round1(num(item.totals && item.totals.fat))),
      fiber: Math.max(0, round1(num(item.totals && item.totals.fiber))),
      grams: Math.max(0, Math.round(num(item.totals && item.totals.grams))),
    };
    const dish = String(item.dish).slice(0, 120);
    const givenScore = Math.round(num(item.healthScore));
    const healthScore = givenScore > 0 ? clamp(givenScore, 1, 10) : computeHealthScore(dish, ingredients, totals);

    map.set(String(item.id), {
      id: String(item.id),
      ts: Number(item.ts) || Date.now(),
      date: String(item.date).slice(0, 10),
      dish,
      description: String(item.description || '').slice(0, 400),
      confidence: clamp(num(item.confidence), 0, 1),
      ingredients,
      totals,
      healthScore,
      manual: Boolean(item.manual),
      editedAt: Number(item.editedAt) || 0,
      thumb: '',
    });
    restored += 1;
  }

  state.entries = Array.from(map.values()).sort((a, b) => (b.ts || 0) - (a.ts || 0));

  const settings = payload.settings || {};
  if (settings.goal) state.settings.goal = clamp(Math.round(num(settings.goal)), 800, 8000);
  if (['auto', 'light', 'dark'].includes(settings.theme)) state.settings.theme = settings.theme;
  if (settings.model) state.settings.model = String(settings.model).slice(0, 80);
  const restoredProfile = sanitizeProfile(settings.profile);
  if (restoredProfile) state.settings.profile = restoredProfile;

  writeJSON(LS.entries, state.entries);
  writeJSON(LS.settings, state.settings);

  applyTheme(state.settings.theme);
  renderHomeSummary();
  renderDiary();
  fillSettings();
  return restored;
}

function restoreBackupCode() {
  const raw = $('#restoreCode').value;
  if (!raw.trim()) {
    toast('Bərpa kodunu yapışdır');
    return;
  }

  let payload;
  try {
    payload = parseBackupCode(raw);
  } catch (err) {
    toast(err instanceof AppError ? err.message : 'Kod yanlışdır və ya natamamdır');
    return;
  }

  const restored = applyBackupPayload(payload);
  $('#restoreCode').value = '';
  toast(`${restored} qeyd bərpa olundu`);
}

async function downloadBackupFile() {
  const payload = buildBackupPayload();
  const json = JSON.stringify(payload, null, 2);
  const filename = `kalori-ai-backup-${dateKey()}.json`;

  try {
    const file = new File([json], filename, { type: 'application/json' });
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({ files: [file], title: 'Kalori AI ehtiyat nüsxəsi' });
      toast('Ehtiyat faylı paylaşıldı');
      return;
    }
  } catch (err) {
    if (err && err.name === 'AbortError') return;
    console.warn(err);
  }

  const blob = new Blob([json], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 5000);
  toast('Ehtiyat faylı hazırlanır');
}

function readFileText(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(String(reader.result || ''));
    reader.onerror = () => reject(reader.error || new Error('read'));
    reader.readAsText(file);
  });
}

async function onBackupFileSelected(event) {
  const input = event.target;
  const file = input.files && input.files[0];
  input.value = '';
  if (!file) return;

  try {
    const text = await readFileText(file);
    const payload = JSON.parse(text);
    if (!payload || !Array.isArray(payload.entries)) throw new Error('format');
    const restored = applyBackupPayload(payload);
    toast(`${restored} qeyd bərpa olundu`);
  } catch (err) {
    console.error(err);
    toast('Fayl yanlışdır və ya zədələnib');
  }
}

/* ---------------- gün dəyişməsi ---------------- */

function rollDay() {
  const now = dateKey();
  if (!state.today || now === state.today) return;
  if (state.selectedDate === state.today) state.selectedDate = now;
  state.today = now;
  renderTodayLabel();
  renderHomeSummary();
  renderDiary();
}

/* ---------------- profil və norma hesablayıcısı ---------------- */

function nearestActivity(value) {
  const v = num(value);
  const hit = ACTIVITY_LEVELS.find((item) => Math.abs(item.value - v) < 0.001);
  return hit ? hit.value : 0;
}

function sanitizeProfile(raw) {
  if (!raw || typeof raw !== 'object') return null;
  const sex = raw.sex === 'f' ? 'f' : raw.sex === 'm' ? 'm' : '';
  const age = Math.round(num(raw.age));
  const height = Math.round(num(raw.height));
  const weight = round1(num(raw.weight));
  const activity = nearestActivity(raw.activity);
  const goal = ['lose', 'maintain', 'gain'].includes(raw.goal) ? raw.goal : '';
  const pace = PACES.includes(num(raw.pace)) ? num(raw.pace) : 0.5;
  const target = round1(num(raw.target));

  if (!sex || !activity || !goal) return null;
  if (age < 14 || age > 100 || height < 120 || height > 230 || weight < 30 || weight > 300) return null;
  if (goal !== 'maintain' && (target < 30 || target > 300)) return null;

  return { sex, age, height, weight, activity, goal, pace, target: goal === 'maintain' ? 0 : target };
}

// Zülal üçün istinad çəkisi: çox artıq çəkidə faktiki çəki əvəzinə düzəldilmiş çəki götürülür
function referenceWeight(profile) {
  const hm = profile.height / 100;
  const bmi = profile.weight / (hm * hm);
  if (bmi <= 30) return profile.weight;
  const ideal = 25 * hm * hm;
  return ideal + 0.25 * (profile.weight - ideal);
}

function proteinPerKg(goal) {
  if (goal === 'lose') return 2.0;
  if (goal === 'gain') return 1.8;
  return 1.6;
}

function profileMacros(profile, kcal) {
  const ref = referenceWeight(profile);
  let protein = Math.min(proteinPerKg(profile.goal) * ref, (kcal * 0.4) / 4);
  let fat = Math.max((kcal * 0.27) / 9, 0.6 * ref);
  let carbs = (kcal - protein * 4 - fat * 9) / 4;

  if (carbs < 50) {
    fat = Math.max(0.6 * ref, (kcal - protein * 4 - 200) / 9);
    carbs = (kcal - protein * 4 - fat * 9) / 4;
  }

  return {
    protein: Math.round(protein),
    carbs: Math.max(0, Math.round(carbs)),
    fat: Math.round(fat),
  };
}

function computeProfilePlan(profile) {
  const { sex, age, height, weight, activity, goal, pace, target } = profile;
  const bmr = 10 * weight + 6.25 * height - 5 * age + (sex === 'm' ? 5 : -161);
  const tdee = bmr * activity;
  const notes = [];
  let error = '';
  let delta = 0;

  if (goal === 'lose') {
    if (target >= weight) error = 'Arıqlamaq üçün hədəf çəki hazırkı çəkidən az olmalıdır.';
    delta = -((pace * KCAL_PER_KG) / 7);
    const cap = tdee * 0.25;
    if (-delta > cap) {
      delta = -cap;
      notes.push('Çox sürətli arıqlama təhlükəlidir — çatışmazlıq normanın 25%-i ilə məhdudlaşdırıldı.');
    }
  } else if (goal === 'gain') {
    if (target <= weight) error = 'Çəki artırmaq üçün hədəf çəki hazırkı çəkidən çox olmalıdır.';
    delta = (pace * KCAL_PER_KG) / 7;
    const cap = tdee * 0.2;
    if (delta > cap) {
      delta = cap;
      notes.push('Artıq kalori normanın 20%-i ilə məhdudlaşdırıldı (artıq yağ yığılmasının qarşısını almaq üçün).');
    }
  }

  let kcal = tdee + delta;
  const floor = sex === 'm' ? 1500 : 1200;
  if (goal === 'lose' && kcal < floor) {
    kcal = floor;
    delta = floor - tdee;
    notes.push(`Təhlükəsiz minimum (${floor} kkal) tətbiq olundu — daha az yemək tövsiyə olunmur.`);
  }
  kcal = clamp(Math.round(kcal / 10) * 10, 800, 8000);

  const macros = profileMacros(profile, kcal);
  const hm = height / 100;
  const bmi = weight / (hm * hm);

  let weeks = 0;
  let date = null;
  if (!error && goal !== 'maintain' && target > 0) {
    const effectiveDelta = Math.abs(kcal - tdee);
    const realPace = effectiveDelta > 0 ? (effectiveDelta * 7) / KCAL_PER_KG : pace;
    weeks = Math.max(1, Math.ceil(Math.abs(weight - target) / Math.max(realPace, 0.05)));
    date = new Date();
    date.setDate(date.getDate() + weeks * 7);
  }

  if (!error && goal !== 'maintain' && target > 0) {
    const targetBmi = target / (hm * hm);
    if (targetBmi < 18.5) notes.push('Hədəf çəki normadan aşağıdır (BMI < 18.5). Həkimlə məsləhətləşməyi tövsiyə edirəm.');
    else if (goal === 'gain' && targetBmi > 30) notes.push('Hədəf çəki yüksək BMI-yə uyğundur; əzələ artımı hədəfləyirsənsə, məşq planı vacibdir.');
  }
  if (age < 18) notes.push('18 yaşdan kiçiklər üçün düstur dəqiq deyil — həkimlə və ya diyetoloqla məsləhətləşin.');

  return {
    bmr: Math.round(bmr),
    tdee: Math.round(tdee),
    delta: Math.round(kcal - tdee),
    kcal,
    ...macros,
    perKg: round1(macros.protein / weight),
    bmi: round1(bmi),
    weeks,
    date,
    notes,
    error,
  };
}

function formatPlanDate(date) {
  return `${date.getDate()} ${AZ_MONTHS[date.getMonth()]} ${date.getFullYear()}`;
}

function formatDuration(weeks) {
  if (weeks < 9) return `${weeks} həftə`;
  const months = Math.round(weeks / 4.345);
  return `~${months} ay (${weeks} həftə)`;
}

function bindProfileEvents() {
  const form = $('#profileForm');
  form.addEventListener('submit', onProfileSave);
  form.addEventListener('input', onProfileInput);
  form.addEventListener('click', onProfileClick);
  $('#btnProfileClear').addEventListener('click', clearProfile);
  renderActivityOptions();
}

function renderActivityOptions() {
  $('#pActivity').innerHTML = ACTIVITY_LEVELS.map(
    (item) => `<button class="act-opt" type="button" role="radio" aria-checked="false" data-act="${item.value}">
      <b>${esc(item.title)}</b><small>${esc(item.desc)}</small>
    </button>`
  ).join('');
}

function emptyDraft() {
  return { sex: '', activity: 0, goal: '', pace: 0.5 };
}

function fillProfileForm() {
  const saved = state.settings.profile;
  state.profileDraft = saved
    ? { sex: saved.sex, activity: saved.activity, goal: saved.goal, pace: saved.pace }
    : emptyDraft();

  $('#pAge').value = saved ? saved.age : '';
  $('#pHeight').value = saved ? saved.height : '';
  $('#pWeight').value = saved ? saved.weight : '';
  $('#pTarget').value = saved && saved.target ? saved.target : '';
  $('#btnProfileClear').classList.toggle('hidden', !saved);
  syncProfileControls();
}

function syncProfileControls() {
  const d = state.profileDraft || emptyDraft();
  $$('#pSex [data-sex]').forEach((b) => b.classList.toggle('active', b.dataset.sex === d.sex));
  $$('#pGoal [data-goal]').forEach((b) => b.classList.toggle('active', b.dataset.goal === d.goal));
  $$('#pPace [data-pace]').forEach((b) => b.classList.toggle('active', num(b.dataset.pace) === d.pace));
  $$('#pActivity [data-act]').forEach((b) => {
    const on = num(b.dataset.act) === d.activity;
    b.classList.toggle('active', on);
    b.setAttribute('aria-checked', on ? 'true' : 'false');
  });
  $('#pTargetWrap').classList.toggle('hidden', !(d.goal === 'lose' || d.goal === 'gain'));
  renderProfilePreview();
}

function onProfileClick(event) {
  const d = state.profileDraft || (state.profileDraft = emptyDraft());
  const sex = event.target.closest('[data-sex]');
  const act = event.target.closest('[data-act]');
  const goal = event.target.closest('[data-goal]');
  const pace = event.target.closest('[data-pace]');

  if (sex) d.sex = sex.dataset.sex;
  else if (act) d.activity = num(act.dataset.act);
  else if (goal) {
    d.goal = goal.dataset.goal;
    if (d.goal === 'gain' && d.pace > 0.5) d.pace = 0.25;
  } else if (pace) d.pace = num(pace.dataset.pace);
  else return;

  syncProfileControls();
}

function onProfileInput() {
  renderProfilePreview();
}

function readProfileDraft() {
  const d = state.profileDraft || emptyDraft();
  return {
    sex: d.sex,
    age: num($('#pAge').value),
    height: num($('#pHeight').value),
    weight: num($('#pWeight').value),
    activity: d.activity,
    goal: d.goal,
    pace: d.pace,
    target: num($('#pTarget').value),
  };
}

function profileMissing(draft) {
  if (!draft.sex) return 'Cinsini seç.';
  if (!(draft.age >= 14 && draft.age <= 100)) return 'Yaşı yaz (14–100).';
  if (!(draft.height >= 120 && draft.height <= 230)) return 'Boyu sm ilə yaz (120–230).';
  if (!(draft.weight >= 30 && draft.weight <= 300)) return 'Çəkini kq ilə yaz (30–300).';
  if (!draft.activity) return 'Aktivlik səviyyəni seç.';
  if (!draft.goal) return 'Məqsədini seç.';
  if (draft.goal !== 'maintain' && !(draft.target >= 30 && draft.target <= 300)) return 'Hədəf çəkini yaz.';
  return '';
}

function renderProfilePreview() {
  const box = $('#pResult');
  const draft = readProfileDraft();
  const missing = profileMissing(draft);

  if (missing) {
    box.innerHTML = `<p class="help">${esc(missing)} Xanalar dolduqca norma burada görünəcək.</p>`;
    return;
  }

  const profile = sanitizeProfile(draft);
  if (!profile) {
    box.innerHTML = '<p class="help">Məlumatları yoxla.</p>';
    return;
  }

  const plan = computeProfilePlan(profile);
  if (plan.error) {
    box.innerHTML = `<div class="note note-warn">${esc(plan.error)}</div>`;
    return;
  }

  const shownDelta = Math.abs(plan.delta) < 10 ? 0 : plan.delta;
  const sign = shownDelta > 0 ? '+' : shownDelta < 0 ? '−' : '';
  const goalLine =
    profile.goal === 'maintain'
      ? 'Mövcud çəkini saxlamaq üçün'
      : `${profile.weight} → ${profile.target} kq, həftədə ${profile.pace} kq · ${esc(formatDuration(plan.weeks))} · təxminən ${esc(formatPlanDate(plan.date))}`;

  box.innerHTML = `
    <div class="plan">
      <div class="plan-kcal"><strong>${fmt(plan.kcal)}</strong><span>kkal / gün</span></div>
      <p class="plan-goal">${goalLine}</p>
      <div class="plan-rows">
        <div><span>Bazal mübadilə (BMR)</span><b>${fmt(plan.bmr)} kkal</b></div>
        <div><span>Gündəlik sərf (TDEE)</span><b>${fmt(plan.tdee)} kkal</b></div>
        <div><span>Hədəfə görə</span><b>${sign}${fmt(Math.abs(shownDelta))} kkal</b></div>
        <div><span>BMI (indi)</span><b>${plan.bmi}</b></div>
      </div>
      <div class="plan-macros">
        <div><small>Zülal</small><b>${plan.protein} q</b><em>${plan.perKg.toFixed(1)} q/kq</em></div>
        <div><small>Karbohidrat</small><b>${plan.carbs} q</b></div>
        <div><small>Yağ</small><b>${plan.fat} q</b></div>
      </div>
      ${plan.notes.map((n) => `<div class="note note-warn">${esc(n)}</div>`).join('')}
    </div>`;
}

function onProfileSave(event) {
  event.preventDefault();
  const draft = readProfileDraft();
  const missing = profileMissing(draft);
  if (missing) {
    toast(missing);
    return;
  }

  const profile = sanitizeProfile(draft);
  if (!profile) {
    toast('Məlumatları yoxla');
    return;
  }

  const plan = computeProfilePlan(profile);
  if (plan.error) {
    toast(plan.error);
    return;
  }

  state.settings.profile = profile;
  state.settings.goal = plan.kcal;
  writeJSON(LS.settings, state.settings);

  $('#setGoal').value = plan.kcal;
  updateGoalMacros();
  $('#btnProfileClear').classList.remove('hidden');
  renderHomeSummary();
  renderDiary();
  toast(`Norma tətbiq olundu: ${fmt(plan.kcal)} kkal`);
}

function clearProfile() {
  if (!confirm('Profil silinsin? Kalori hədəfi qalır, makrolar yenidən 25/45/30 bölgüsünə qayıdır.')) return;
  state.settings.profile = null;
  writeJSON(LS.settings, state.settings);
  fillProfileForm();
  updateGoalMacros();
  renderHomeSummary();
  renderDiary();
  toast('Profil silindi');
}

function goToProfile() {
  setTab('settings');
  setTimeout(() => $('#profileForm').scrollIntoView({ behavior: 'smooth', block: 'start' }), 200);
}

/* ---------------- iOS hint & SW ---------------- */

function maybeShowIosHint() {
  const ua = navigator.userAgent || '';
  const isIOS = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const standalone =
    window.navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches;
  if (isIOS && !standalone && !localStorage.getItem(LS.iosHint)) {
    $('#iosHint').classList.remove('hidden');
  }
}

function dismissIosHint() {
  try {
    localStorage.setItem(LS.iosHint, '1');
  } catch {
    /* ignore */
  }
  $('#iosHint').classList.add('hidden');
}

function registerSW() {
  if (!('serviceWorker' in navigator)) return;
  window.addEventListener('load', () => {
    navigator.serviceWorker
      .register('./sw.js', { updateViaCache: 'none' })
      .catch((err) => console.warn('SW qeydiyyatı:', err));
  });
}
